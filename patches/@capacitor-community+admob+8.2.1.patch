@@ -0,0 +1,80 @@
+//
+// CAPCompat.swift
+// Compatibility shims for capacitor-swift-pm >= 8.4 binary distribution,
+// where several Swift convenience APIs on CAPPluginCall / CAPBridgeProtocol
+// are gated behind the $NonescapableTypes experimental feature and are not
+// visible to client plugins. These extensions re-implement the missing
+// methods using the always-available Objective-C APIs.
+//
+
+import Foundation
+import Capacitor
+import WebKit
+
+extension CAPPluginCall {
+
+    // MARK: - Option getters (unconditional variants)
+
+    func compat_getBool(_ key: String) -> Bool? {
+        return (options as? [String: Any])?[key] as? Bool
+    }
+
+    func compat_getString(_ key: String) -> String? {
+        return (options as? [String: Any])?[key] as? String
+    }
+
+    func compat_getInt(_ key: String) -> Int? {
+        let v = (options as? [String: Any])?[key]
+        if let i = v as? Int { return i }
+        if let n = v as? NSNumber { return n.intValue }
+        return nil
+    }
+
+    func compat_getFloat(_ key: String) -> Float? {
+        let v = (options as? [String: Any])?[key]
+        if let f = v as? Float { return f }
+        if let d = v as? Double { return Float(d) }
+        if let n = v as? NSNumber { return n.floatValue }
+        return nil
+    }
+
+    func compat_getDouble(_ key: String) -> Double? {
+        let v = (options as? [String: Any])?[key]
+        if let d = v as? Double { return d }
+        if let n = v as? NSNumber { return n.doubleValue }
+        return nil
+    }
+
+    func compat_getArray(_ key: String) -> [Any]? {
+        return (options as? [String: Any])?[key] as? [Any]
+    }
+
+    func compat_getArray<T>(_ key: String, ofType: T.Type) -> [T]? {
+        return (options as? [String: Any])?[key] as? [T]
+    }
+
+    // MARK: - reject (via errorHandler, since the Swift reject is gated)
+
+    func compat_reject(_ message: String, _ code: String? = nil) {
+        // CAPPluginCallError's Swift init is gated, but the ObjC
+        // -init:message:code:error:data: is exposed via the generated header.
+        let err = CAPPluginCallError(message: message, code: code, error: nil, data: nil)
+        self.errorHandler(err)
+    }
+}
+
+extension CAPBridgeProtocol {
+    /// WKWebView lookup without the gated `webView` property:
+    /// walk down from the bridge's view controller.
+    var compat_webView: WKWebView? {
+        var view: UIView? = self.viewController?.view
+        // BFS through subviews to find the WKWebView
+        var queue: [UIView] = view.map { [$0] } ?? []
+        while !queue.isEmpty {
+            let v = queue.removeFirst()
+            if let wv = v as? WKWebView { return wv }
+            queue.append(contentsOf: v.subviews)
+        }
+        return nil
+    }
+}
