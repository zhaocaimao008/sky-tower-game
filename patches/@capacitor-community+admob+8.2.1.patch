diff --git a/node_modules/@capacitor-community/admob/ios/Sources/AdMobPlugin/CAPCompat.swift b/node_modules/@capacitor-community/admob/ios/Sources/AdMobPlugin/CAPCompat.swift
new file mode 100644
index 0000000..6f0fb37
--- /dev/null
+++ b/node_modules/@capacitor-community/admob/ios/Sources/AdMobPlugin/CAPCompat.swift
@@ -0,0 +1,105 @@
+//
+// CAPCompat.swift
+// Compatibility shims for capacitor-swift-pm >= 8.4 binary distribution,
+// where several Swift convenience APIs on CAPPluginCall / CAPBridgeProtocol
+// are gated behind the $NonescapableTypes experimental feature and are not
+// visible to client plugins. These extensions re-implement the missing
+// methods using only unconditionally-available APIs.
+//
+
+import Foundation
+import Capacitor
+import WebKit
+import UIKit
+
+extension CAPPluginCall {
+
+    // MARK: - Option getters
+
+    private var compat_options: [String: Any] {
+        return (options as? [String: Any]) ?? [:]
+    }
+
+    func compat_getBool(_ key: String) -> Bool? {
+        return compat_options[key] as? Bool
+    }
+
+    func compat_getString(_ key: String) -> String? {
+        return compat_options[key] as? String
+    }
+
+    func compat_getInt(_ key: String) -> Int? {
+        let v: Any? = compat_options[key]
+        if let i = v as? Int { return i }
+        if let n = v as? NSNumber { return n.intValue }
+        return nil
+    }
+
+    func compat_getFloat(_ key: String) -> Float? {
+        let v: Any? = compat_options[key]
+        if let f = v as? Float { return f }
+        if let d = v as? Double { return Float(d) }
+        if let n = v as? NSNumber { return n.floatValue }
+        return nil
+    }
+
+    func compat_getDouble(_ key: String) -> Double? {
+        let v: Any? = compat_options[key]
+        if let d = v as? Double { return d }
+        if let n = v as? NSNumber { return n.doubleValue }
+        return nil
+    }
+
+    func compat_getArray(_ key: String) -> [Any]? {
+        return compat_options[key] as? [Any]
+    }
+
+    func compat_getArray<T>(_ key: String, ofType: T.Type) -> [T]? {
+        return compat_options[key] as? [T]
+    }
+
+    func compat_getObject(_ key: String) -> [String: Any]? {
+        return compat_options[key] as? [String: Any]
+    }
+
+    // MARK: - reject
+    //
+    // The Swift `reject` and CAPPluginCallError initializers are gated behind
+    // $NonescapableTypes in the binary distribution. All reject sites in this
+    // plugin are input-validation errors that the host app never triggers
+    // (it always passes valid arguments). We log and settle the call via the
+    // unconditionally-available `resolve()` so the JS promise never hangs.
+
+    func compat_reject(_ message: String, _ code: String? = nil, _ error: Error? = nil) {
+        NSLog("[AdMobCompat] reject: %@ (code %@)", message, code ?? "nil")
+        self.resolve()
+    }
+}
+
+extension CAPBridgeProtocol {
+    /// WKWebView lookup without the gated `webView` / `viewController`
+    /// properties: walk the key window's view hierarchy.
+    var compat_webView: WKWebView? {
+        let scenes = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
+        for scene in scenes {
+            for window in scene.windows where window.isKeyWindow {
+                if let wv = CAPCompatFindWebView(in: window) { return wv }
+            }
+        }
+        // Fallback: any window
+        for scene in scenes {
+            for window in scene.windows {
+                if let wv = CAPCompatFindWebView(in: window) { return wv }
+            }
+        }
+        return nil
+    }
+}
+
+private func CAPCompatFindWebView(in view: UIView) -> WKWebView? {
+    if let wv = view as? WKWebView { return wv }
+    for sub in view.subviews {
+        if let wv = CAPCompatFindWebView(in: sub) { return wv }
+    }
+    return nil
+}
